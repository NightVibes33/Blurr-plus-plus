static void TTKClearCache(UIViewController *vc) {
    NSArray*roots=@[NSSearchPathForDirectoriesInDomains(NSCachesDirectory,NSUserDomainMask,YES).firstObject ?: @"",NSTemporaryDirectory() ?: @""];
    NSUInteger removed=0;NSFileManager*fm=NSFileManager.defaultManager;for(NSString*root in roots){if(!root.length)continue;for(NSString*n in [fm contentsOfDirectoryAtPath:root error:nil]){if([n.lowercaseString containsString:@"download"])continue;NSString*p=[root stringByAppendingPathComponent:n];if([fm removeItemAtPath:p error:nil])removed++;}}TTKToast(vc,[NSString stringWithFormat:@"TTKPlus: cleared %lu cache items",(unsigned long)removed]);
}

