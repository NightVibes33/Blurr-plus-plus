- (UITableViewCell*)tableView:(UITableView*)tv cellForRowAtIndexPath:(NSIndexPath*)ip{NSDictionary*d=self.sections[ip.section][ip.row];UITableViewCell*c=[[UITableViewCell alloc]initWithStyle:UITableViewCellStyleSubtitle reuseIdentifier:nil];c.textLabel.text=d[@"t"];NSString*k=d[@"k"];if(k){UISwitch*sw=[UISwitch new];sw.on=[[NSUserDefaults standardUserDefaults]boolForKey:k];sw.accessibilityIdentifier=k;[sw addTarget:self action:@selector(toggle:) forControlEvents:UIControlEventValueChanged];c.accessoryView=sw;}else c.accessoryType=UITableViewCellAccessoryDisclosureIndicator;return c;}
- (void)toggle:(UISwitch*)s{[[NSUserDefaults standardUserDefaults]setBool:s.on forKey:s.accessibilityIdentifier];}
- (void)tableView:(UITableView*)tv didSelectRowAtIndexPath:(NSIndexPath*)ip{[tv deselectRowAtIndexPath:ip animated:YES];NSString*a=self.sections[ip.section][ip.row][@"a"];if(!a)return;
    if([a isEqual:@"cache"]){TTKClearCache(self);return;} if([a isEqual:@"reset"]){for(NSString*k in TTKFeatureKeys())[[NSUserDefaults standardUserDefaults]removeObjectForKey:k];[[NSUserDefaults standardUserDefaults]removeObjectForKey:@"TTKPlus_LiveAutoClickCount"];TTKRegisterDefaults();[tv reloadData];return;}
