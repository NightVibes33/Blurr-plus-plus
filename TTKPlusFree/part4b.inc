      @[@{@"a":@"region",@"t":@"Region Override"},@{@"a":@"livecount",@"t":@"LIVE Auto-Like Count"},@{@"a":@"cache",@"t":@"Clear Cache"},@{@"a":@"icon",@"t":@"Alternate App Icon"},@{@"a":@"language",@"t":@"App Language"},@{@"a":@"flex",@"t":@"FLEX Explorer"},@{@"a":@"reset",@"t":@"Reset TTKPlus Settings"}]
