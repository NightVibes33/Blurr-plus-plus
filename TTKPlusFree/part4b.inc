    if([a isEqual:@"region"]){UIAlertController*x=[UIAlertController alertControllerWithTitle:@"Region Override" message:@"ISO / MCC / MNC" preferredStyle:UIAlertControllerStyleAlert];for(NSString*p in @[@"ISO (US)",@"MCC (310)",@"MNC (260)"])[x addTextFieldWithConfigurationHandler:^(UITextField*f){f.placeholder=p;}];[x addAction:[UIAlertAction actionWithTitle:@"Apply" style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction*z){NSArray<UITextField*>*f=x.textFields;[[NSUserDefaults standardUserDefaults]setObject:[f[0].text uppercaseString] forKey:@"TTKPlus_RegionISO"];[[NSUserDefaults standardUserDefaults]setObject:f[1].text forKey:@"TTKPlus_RegionMCC"];[[NSUserDefaults standardUserDefaults]setObject:f[2].text forKey:@"TTKPlus_RegionMNC"];}]];[x addAction:[UIAlertAction actionWithTitle:@"Clear" style:UIAlertActionStyleDestructive handler:^(__unused UIAlertAction*z){for(NSString*k in @[@"TTKPlus_RegionISO",@"TTKPlus_RegionMCC",@"TTKPlus_RegionMNC"])[[NSUserDefaults standardUserDefaults]removeObjectForKey:k];}]];[self presentViewController:x animated:YES completion:nil];return;}
    if([a isEqual:@"icon"]){NSDictionary*icons=[NSBundle.mainBundle objectForInfoDictionaryKey:@"CFBundleIcons"][@"CFBundleAlternateIcons"];UIAlertController*x=[UIAlertController alertControllerWithTitle:@"Alternate Icon" message:nil preferredStyle:UIAlertControllerStyleActionSheet];[x addAction:[UIAlertAction actionWithTitle:@"Default" style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction*z){[UIApplication.sharedApplication setAlternateIconName:nil completionHandler:nil];}]];for(NSString*n in icons.allKeys)[x addAction:[UIAlertAction actionWithTitle:n style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction*z){[UIApplication.sharedApplication setAlternateIconName:n completionHandler:nil];}]];[x addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];[self presentViewController:x animated:YES completion:nil];return;}
    if([a isEqual:@"language"]){UIAlertController*x=[UIAlertController alertControllerWithTitle:@"Language" message:@"Applied after relaunch" preferredStyle:UIAlertControllerStyleActionSheet];NSDictionary*langs=@{@"Auto (System)":@"",@"English":@"en",@"Arabic":@"ar",@"Chinese":@"zh-Hans",@"German":@"de",@"Spanish":@"es",@"French":@"fr",@"Polish":@"pl"};for(NSString*n in langs){[x addAction:[UIAlertAction actionWithTitle:n style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction*z){NSString*c=langs[n];if(c.length)[[NSUserDefaults standardUserDefaults]setObject:@[c] forKey:@"AppleLanguages"];else [[NSUserDefaults standardUserDefaults]removeObjectForKey:@"AppleLanguages"];}]];}[x addAction:[UIAlertAction actionWithTitle:@"Cancel" style:UIAlertActionStyleCancel handler:nil]];[self presentViewController:x animated:YES completion:nil];return;}
